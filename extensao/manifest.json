{
  "manifest_version": 3,
  "name": "Copiador de Dados de Formulário",
  "version": "1.1",
  "description": "Captura dados preenchidos em uma página e cola em campos de outra página automaticamente. Extrai códigos de rastreio da Shopee.",
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {},
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://shopee.com.br/user/purchase*"],
      "js": ["content-list.js"],
      "run_at": "document_idle"
    }
  ]
}
